# Copy to backend/.env and fill in. Render takes the same keys.
PORT=4000
NODE_ENV=development
# The frontend's origin, allowed to call the backend from another domain (exact, no trailing slash).
FRONTEND_URL=http://localhost:3000

# Zoom Marketplace app: client id and secret (the secret also decrypts the app context token),
# and the Secret Token from Features > Event subscriptions (signs webhooks; the same for both credential sets).
# ZOOM_CLIENT_* is the production set. The development set is optional: with it, the build page's
# test app can open the same deployment. Locally, the development set alone in ZOOM_CLIENT_* is enough.
ZOOM_CLIENT_ID=xxxxxxxx
ZOOM_CLIENT_SECRET=xxxxxxxx
ZOOM_DEV_CLIENT_ID=
ZOOM_DEV_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=xxxxxxxx

# DynamoDB: an IAM user limited to the two tables.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=xxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxx
TEMPLATES_TABLE=
MEETINGS_TABLE=

# ASU CreateAI service token (Profile > API Keys on platform.aiml.asu.edu).
CREATEAI_API_KEY=xxxxxxxx
